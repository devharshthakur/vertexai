# Build context: everything the image needs, and nothing that would make it
# large, slow, or secret-bearing.

# Dependencies and build output are installed inside the image.
node_modules
.nuxt
.output
.nitro
.cache
dist

# Git and the local environment stay out of the image.
.git
.gitignore
.env
.env.*
!.env.example

# The demo lecture videos are mounted at runtime, never baked in.
public/videos/**/*.mp4
public/videos/**/*.webm
public/videos/**/*.mkv
public/videos/**/*.mov
public/videos/**/*.m4v
public/videos/**/*.ogv

# Repository files that are not needed to build or run the application.
.agents
.opencode
.vscode
.husky
.github
docs
*.log
.DS_Store
