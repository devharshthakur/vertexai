# Local PostgreSQL (Docker Compose)
POSTGRES_USER=vertexai
POSTGRES_PASSWORD=vertexai
POSTGRES_DB=vertexai

# Host port the database is published on. 5433 avoids clashing with a
# PostgreSQL that already listens on 5432 on this machine.
POSTGRES_PORT=5433

# Used by drizzle-kit and by the Nuxt server (server/db).
DATABASE_URL=postgresql://vertexai:vertexai@localhost:5433/vertexai

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-random-32-character-secret
# Base URL of the app. Must match the port `pnpm dev` serves on.
BETTER_AUTH_URL=http://localhost:5173

# GitHub OAuth (optional). The sign-in button is hidden until both values
# are set. Register the OAuth app with this callback URL:
# http://localhost:5173/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
