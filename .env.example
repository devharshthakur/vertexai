# Local PostgreSQL (Docker Compose)
POSTGRES_USER=vertexai
POSTGRES_PASSWORD=vertexai
POSTGRES_DB=vertexai

# Host port the database is published on. 5433 avoids clashing with a
# PostgreSQL that already listens on 5432 on this machine.
POSTGRES_PORT=5433

# Used by drizzle-kit and by the Nuxt server (server/db).
DATABASE_URL=postgresql://vertexai:vertexai@localhost:5433/vertexai

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-random-32-character-secret
# Base URL of the app. Must match the port `pnpm dev` serves on.
BETTER_AUTH_URL=http://localhost:5173

# Optional absolute path outside the repository for uploaded course materials.
# Defaults to ~/.local/share/vertexai/course-materials.
# COURSE_MATERIALS_DIR=

# GitHub OAuth (optional). The sign-in button is hidden until both values
# are set. Register the OAuth app with this callback URL:
# http://localhost:5173/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI tutor (Vercel AI Gateway through the Vercel AI SDK). Leave the key empty to
# show the tutor's unavailable state; the rest of the app keeps working. Get a
# key at https://vercel.com/ai-gateway.
AI_GATEWAY_API_KEY=

# Optional model overrides. Model ids use the gateway "provider/model" format;
# the chat model powers grounded answers and lecture summaries, and the embedding
# model indexes lecture transcripts. Vectors are stored with 1536 dimensions,
# which is what the database column expects.
AI_CHAT_MODEL=openai/gpt-6-luna
AI_EMBEDDING_MODEL=openai/text-embedding-3-large

# Token budgets for transcript indexing. A transcript is split into chunks that
# are embedded in bounded batches, so a lecture of any length can be indexed.
# AI_EMBEDDING_MAX_INPUT_TOKENS is the input window of the embedding model
# (8192 for openai/text-embedding-3-large), and AI_EMBEDDING_CHUNK_TOKENS is the
# size of one chunk. The chunk budget must stay below the input window.
AI_EMBEDDING_MAX_INPUT_TOKENS=8192
AI_EMBEDDING_CHUNK_TOKENS=1500
# Maximum transcript characters sent to summary and quiz-draft generation.
AI_GENERATION_MAX_TRANSCRIPT_CHARACTERS=64000
