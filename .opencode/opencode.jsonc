{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "better-auth": {
        "type": "remote",
        "url": "https://mcp.better-auth.com/mcp",
        "disabled": false,
      },
      "shadcnVue": {
        "type": "local",
        "command": [
          "npx",
          "shadcn-vue@latest",
          "mcp"
        ],
        "disabled": false,
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest"
        ],
        "disabled": false,
      }
    }
  }
}
