{
  "name": "vertexai",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 5173",
    "typecheck": "nuxt typecheck",
    "generate": "nuxt generate",
    "preview": "nuxt preview --port 4173",
    "clean": "nuxt cleanup",
    "clean:all": "nuxt cleanup && node -e \"require('node:fs').rmSync('node_modules', { recursive: true, force: true })\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --ignore-unknown --list-different .",
    "postinstall": "nuxt prepare",
    "prepare": "husky"
  },
  "dependencies": {
    "@lucide/vue": "1.59.0",
    "@nuxt/fonts": "1.0.1",
    "@nuxt/icon": "2.5.1",
    "@nuxtjs/color-mode": "4.0.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "nuxt": "4.6.2",
    "reka-ui": "2.11.0",
    "shadcn-vue": "2.8.2",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.145",
    "@nuxt/eslint": "1.17.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "nano-staged": "1.0.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn-nuxt": "2.8.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13"
  }
}
