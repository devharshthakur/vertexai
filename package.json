{
  "name": "vertexai",
  "version": "0.1.0",
  "description": "An AI-augmented learning management system with a course-grounded AI tutor, built with Nuxt 4, Vue 3, and TypeScript.",
  "type": "module",
  "private": true,
  "author": {
    "name": "Harsh Thakur",
    "email": "harshprojects2002@outlook.com",
    "url": "https://github.com/devharshthakur/"
  },
  "license": "MIT",
  "homepage": "https://github.com/devharshthakur/vertexai#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/devharshthakur/vertexai.git"
  },
  "keywords": [
    "lms",
    "ai-tutor",
    "rag",
    "e-learning",
    "nuxt",
    "vue",
    "typescript"
  ],
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 5173",
    "typecheck": "nuxt typecheck",
    "generate": "nuxt generate",
    "preview": "nuxt preview --port 4173",
    "clean": "nuxt cleanup",
    "git:clean": "cleanup --auto",
    "clean:all": "nuxt cleanup && node -e \"require('node:fs').rmSync('node_modules', { recursive: true, force: true })\"",
    "merge": "tsx scripts/merge.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:start": "docker compose start db",
    "db:stop": "docker compose stop db",
    "db:logs": "docker compose logs -f db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx server/db/seed.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write --ignore-unknown --list-different .",
    "format:check": "prettier --check --ignore-unknown .",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck",
    "postinstall": "nuxt prepare",
    "prepare": "husky && nuxt prepare"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.13",
    "@lucide/vue": "1.61.0",
    "@nuxt/fonts": "1.2.0",
    "@nuxt/icon": "2.6.1",
    "@nuxtjs/color-mode": "4.0.1",
    "@tanstack/vue-form": "1.33.5",
    "@tanstack/vue-query": "5.105.0",
    "@vueuse/core": "15.0.0",
    "better-auth": "1.7.13",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.0",
    "drizzle-orm": "0.45.4",
    "nuxt": "4.6.2",
    "pg": "8.23.1",
    "reka-ui": "2.11.0",
    "tw-animate-css": "1.4.0",
    "vue": "3.5.44",
    "vue-router": "5.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@devharshthakur/cleanup": "0.1.0",
    "@iconify-json/lucide": "1.2.147",
    "@iconify-json/simple-icons": "1.2.101",
    "@nuxt/eslint": "1.17.0",
    "@shadcn/lint": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.105.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "dotenv": "18.0.9",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "nano-staged": "1.0.2",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn-nuxt": "2.8.2",
    "shadcn-vue": "2.8.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13"
  }
}
